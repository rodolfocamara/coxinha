    },
    {
      "id": "1320-122617-0023",
      "speaker_id": 1320,
      "text": "UNCAS WHO HAD ALREADY APPROACHED THE DOOR IN READINESS TO LEAD THE WAY NOW RECOILED AND PLACED HIMSELF ONCE MORE IN THE BOTTOM OF THE LODGE",
      "row": 101,
      "sha256": "553fc6594343774831ac876fee34c4ec2b47b53d451f313b10e64eea5cadd8c2",
      "wav_sha256": "c5670d7da6e3c6267d43cd8220bf4f17e94c9eb2ab0b9cd2d8f40d96b3961164",
      "source": "https://datasets-server.huggingface.co/rows?dataset=openslr/librispeech_asr&config=clean&split=test&offset=101&length=1",
      "source_asset_revision": "71cacbfb7e2354c4226d01e70d77d5fca3d04ba1"
    },
    {
      "id": "260-123286-0000",
      "speaker_id": 260,
      "text": "SATURDAY AUGUST FIFTEENTH THE SEA UNBROKEN ALL ROUND NO LAND IN SIGHT",

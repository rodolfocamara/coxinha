    },
    {
      "id": "6930-75918-0002",
      "speaker_id": 6930,
      "text": "CONGRATULATIONS WERE POURED IN UPON THE PRINCESS EVERYWHERE DURING HER JOURNEY",
      "row": 2,
      "sha256": "74ecfd628f49dca71995972c075fcc9904df804d49a4eb5b11fb712b3584f789",
      "wav_sha256": "39dd5ef6168667cf05ee3c332b6fef3e241c5373edfe59ed1066b40722258c05",

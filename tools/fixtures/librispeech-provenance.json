      "source_asset_revision": "71cacbfb7e2354c4226d01e70d77d5fca3d04ba1"
    },
    {
      "id": "1320-122617-0022",
      "speaker_id": 1320,
      "text": "THE DELAWARES ARE CHILDREN OF THE TORTOISE AND THEY OUTSTRIP THE DEER",
      "row": 100,
      "sha256": "9c4d285c536c8562a3b9add558d159b84c5b3d8c27922669906ae8da831fc25c",
      "wav_sha256": "d759256c38d36cd12c8c32ea496d150367b9572be21a0b376cf965f340f80be4",

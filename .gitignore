# Rust
target/
**/*.rs.bk
Cargo.lock.bak

# Node
node_modules/
dist/
.pnpm-store/
*.tsbuildinfo
pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Vite
.vite/

# Tauri
src-tauri/target/
src-tauri/gen/

# Editor / IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Env
.env
.env.local
.env.*.local

# Downloaded models (can be gigabytes)
models/
*.gguf
*.bin
*.onnx
*.onnx.data
# Silero VAD is embedded via include_bytes! (~2.3 MB); every build
# needs it, so the bundled copy lives in the repo (ADR-0014).
!src-tauri/resources/silero_vad.onnx

# Dev user data
dev-vault/
*.db
*.db-journal
*.db-shm
*.db-wal

# Build artifacts
*.msi
*.exe
!src-tauri/icons/*.png
!src-tauri/icons/*.ico
!src-tauri/icons/*.icns

# Logs
*.log
logs/

# Claude Code / tooling caches
.claude/
.playwright-mcp/

# Per-machine MCP server config (paths are absolute and OS-specific)
.mcp.json

# Local design scratch / unrelated project files dropped into docs/ui/
docs/ui/

# Synthetic migration fixtures are product test inputs, never operator databases.
!coxinha-core/tests/fixtures/session-v3/library/meetings.db
!coxinha-core/tests/fixtures/session-v3/library/private/profiles.db
!coxinha-core/tests/fixtures/session-v4/library/meetings.db
!coxinha-core/tests/fixtures/session-v4/library/private/profiles.db

# Python bytecode from tools/ scripts.
__pycache__/
